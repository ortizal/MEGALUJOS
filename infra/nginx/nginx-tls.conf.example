# =============================================================================
# MEGALUJOS — nginx CON TLS (ejemplo) — sustituye a nginx.conf en producción
# =============================================================================
# ACTIVACIÓN (ver también los comentarios TLS de infra/compose.yaml):
#
#   1. Emitir el certificado (webroot, una vez):
#        mkdir -p infra/nginx/certs infra/nginx/www/certbot
#        docker run --rm \
#          -v "$PWD/infra/nginx/certs:/etc/letsencrypt" \
#          -v "$PWD/infra/nginx/www/certbot:/var/www/certbot" \
#          certbot/certbot certonly --webroot -w /var/www/certbot \
#          -d megalujos.com -d www.megalujos.com -d admin.megalujos.com \
#          --email ops@megalujos.com --agree-tos --non-interactive
#
#   2. En infra/compose.yaml, del servicio nginx:
#        volumes:
#          - ./nginx/nginx-tls.conf.example:/etc/nginx/nginx.conf:ro
#          - ./certs:/etc/nginx/certs:ro          # letsencrypt live/ + archive/
#          - ./nginx/www/certbot:/var/www/certbot:ro
#        (el bloque de certbot ya no necesita el puerto 80 abierto al público,
#         pero conviene dejarlo para la renovación)
#
#   3. Renovación automática (cron del host):
#        0 3 * * 1 docker run --rm -v "$PWD/infra/nginx/certs:/etc/letsencrypt" \
#           -v "$PWD/infra/nginx/www/certbot:/var/www/certbot" \
#           certbot/certbot renew --webroot -w /var/www/certbot \
#           --post-hook "docker exec megalujos-nginx nginx -s reload"
#
#   4. Tras renovar: docker exec megalujos-nginx nginx -t && nginx -s reload
#
# PLACEHOLDERS (sustituir antes de usar):
#   {{DOMINIO}}              -> megalujos.com
#   {{ADMIN_SUBDOMINIO}}     -> admin.megalujos.com  (opcional)
#   {{EMAIL}}                -> ops@megalujos.com
#   Las rutas de certificado siguen la estructura de certbot:
#     /etc/nginx/certs/live/{{DOMINIO}}/fullchain.pem
#     /etc/nginx/certs/live/{{DOMINIO}}/privkey.pem
# =============================================================================

user                  nginx;
worker_processes      auto;
error_log             /var/log/nginx/error.log warn;
pid                   /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include             /etc/nginx/mime.types;
    default_type        application/octet-stream;
    charset             utf-8;

    log_format main     '$remote_addr - $remote_user [$time_local] "$request" '
                        '$status $body_bytes_sent "$http_referer" '
                        '"$http_user_agent" rt=$request_time';
    access_log          /var/log/nginx/access.log main;

    sendfile            on;
    tcp_nopush          on;
    keepalive_timeout   65;
    server_tokens       off;
    client_max_body_size 50M;

    gzip                on;
    gzip_vary           on;
    gzip_comp_level     5;
    gzip_min_length     256;
    gzip_proxied        any;
    gzip_types          text/plain text/css text/xml text/javascript
                        application/json application/javascript
                        application/xml application/xml+rss
                        image/svg+xml application/font-woff application/font-woff2;

    # --- Parámetros TLS (HSTS + TLS 1.2/1.3) --------------------------------
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;

    upstream backend_api       { server backend:8080; keepalive 32; }
    upstream admin_app         { server admin:80;      keepalive 8; }
    upstream storefront_app    { server storefront:80; keepalive 8; }

    # =========================================================================
    # Puerto 80: renovación ACME + redirección a HTTPS
    # =========================================================================
    server {
        listen              80;
        server_name         {{DOMINIO}} www.{{DOMINIO}} {{ADMIN_SUBDOMINIO}};

        # Webroot de certbot (no redirigir)
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    # =========================================================================
    # Puerto 443: sitio completo
    # =========================================================================
    server {
        listen              443 ssl;
        http2               on;
        server_name         {{DOMINIO}} www.{{DOMINIO}};

        # --- Certificados (certbot) ------------------------------------------
        ssl_certificate     /etc/nginx/certs/live/{{DOMINIO}}/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/live/{{DOMINIO}}/privkey.pem;
        ssl_trusted_certificate /etc/nginx/certs/live/{{DOMINIO}}/chain.pem;

        # --- Cabeceras de seguridad -----------------------------------------
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options           "SAMEORIGIN" always;
        add_header X-Content-Type-Options    "nosniff" always;
        add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy        "geolocation=(), microphone=(), camera=()" always;

        # --- API -------------------------------------------------------------
        location /api/ {
            proxy_pass             http://backend_api;
            proxy_http_version     1.1;
            proxy_set_header       Host              $host;
            proxy_set_header       X-Real-IP         $remote_addr;
            proxy_set_header       X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header       X-Forwarded-Proto $scheme;
            proxy_set_header       Connection        "";
            proxy_connect_timeout  10s;
            proxy_send_timeout     60s;
            proxy_read_timeout     60s;
        }

        location /uploads/ {
            proxy_pass             http://backend_api;
            proxy_http_version     1.1;
            proxy_set_header       Host              $host;
            proxy_set_header       X-Real-IP         $remote_addr;
            proxy_set_header       X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header       X-Forwarded-Proto $scheme;
            proxy_send_timeout     60s;
            proxy_read_timeout     60s;
        }

        location /swagger-ui {
            proxy_pass             http://backend_api;
            proxy_http_version     1.1;
            proxy_set_header       Host $host;
            proxy_set_header       X-Forwarded-Proto $scheme;
        }

        location /v3/api-docs {
            proxy_pass             http://backend_api;
            proxy_http_version     1.1;
            proxy_set_header       Host $host;
            proxy_set_header       X-Forwarded-Proto $scheme;
        }

        location = /actuator/health {
            proxy_pass             http://backend_api;
            proxy_http_version     1.1;
            proxy_set_header       Host $host;
        }

        location /actuator { return 404; }

        # --- Admin bajo /admin/ ---------------------------------------------
        location = /admin { return 301 /admin/; }

        location /admin/ {
            rewrite ^/admin/(.*)$ /$1 break;
            proxy_pass             http://admin_app;
            proxy_http_version     1.1;
            proxy_set_header       Host              $host;
            proxy_set_header       X-Real-IP         $remote_addr;
            proxy_set_header       X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header       X-Forwarded-Proto $scheme;
        }

        # --- Storefront (SPA) ------------------------------------------------
        location / {
            proxy_pass             http://storefront_app;
            proxy_http_version     1.1;
            proxy_set_header       Host              $host;
            proxy_set_header       X-Real-IP         $remote_addr;
            proxy_set_header       X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header       X-Forwarded-Proto $scheme;
        }

        location = /favicon.ico { access_log off; log_not_found off; }
    }

    # =========================================================================
    # ALTERNATIVA: admin en subdominio (BASE_HREF=/ en el build del servicio)
    # =========================================================================
    # server {
    #     listen              443 ssl;
    #     http2               on;
    #     server_name         {{ADMIN_SUBDOMINIO}};
    #
    #     ssl_certificate     /etc/nginx/certs/live/{{DOMINIO}}/fullchain.pem;
    #     ssl_certificate_key /etc/nginx/certs/live/{{DOMINIO}}/privkey.pem;
    #
    #     add_header Strict-Transport-Security "max-age=31536000" always;
    #     add_header X-Frame-Options           "SAMEORIGIN" always;
    #     add_header X-Content-Type-Options    "nosniff" always;
    #     add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    #
    #     location / {
    #         proxy_pass          http://admin_app;
    #         proxy_http_version  1.1;
    #         proxy_set_header    Host              $host;
    #         proxy_set_header    X-Real-IP         $remote_addr;
    #         proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
    #         proxy_set_header    X-Forwarded-Proto $scheme;
    #     }
    # }
}
