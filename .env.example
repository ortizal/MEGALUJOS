# Megalujos Environment Variables Example
# Copiar este archivo a .env y ajustar según corresponda

# Base de datos PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/megalujos_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=12345

# Seguridad JWT
JWT_SECRET=megalujos_super_secure_jwt_secret_key_2026_ecuador_automotive_access_token
JWT_EXPIRATION_MINUTES=120
JWT_REFRESH_EXPIRATION_DAYS=7

# Servidor y Puertos
SERVER_PORT=8080
FRONTEND_ADMIN_PORT=4200
FRONTEND_STOREFRONT_PORT=4300

# Negocio y Localización
BUSINESS_NAME=MEGALUJOS
BUSINESS_RUC=1790012345001
BUSINESS_COUNTRY=EC
BUSINESS_CURRENCY=USD
TIMEZONE=America/Guayaquil
WHATSAPP_NUMBER=593999999999

# SRI Facturación Electrónica (Ambiente: 1=Pruebas, 2=Producción)
SRI_ENVIRONMENT=1
SRI_ESTABLISHMENT=001
SRI_EMISSION_POINT=001
SRI_CERTIFICATE_PATH=./certificates/signature.p12
SRI_CERTIFICATE_PASSWORD=

# Almacenamiento local de archivos
STORAGE_LOCAL_PATH=./uploads
